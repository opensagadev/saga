build:target --per_file_copt=^src/legoapi/render/core/terrain_stubs\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/character/transform\.cpp$@-O3
# The original static initializer and array maintenance require -O3.
build:target --per_file_copt=^src/legoapi/actions/character/simpletons\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/character/specialmoves\.cpp$@-O3
# Snake-body allocation and destruction are optimized in the target: the
# four-slot search is unrolled and the fixed-size clear is emitted inline.
build:target --per_file_copt=^src/legoapi/actions/character/snake\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/character/suit\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/combat/hits\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/combat/fighting\.cpp$@-O3
# Whip action dispatch is optimized in the target, including its animation
# state transitions and target-selection fallbacks.
build:target --per_file_copt=^src/legoapi/actions/combat/whip\.cpp$@-O3
# The rope material setup is optimized in the target: its local buffer clear,
# material bitfield initialization, and success/failure paths are folded.
build:target --per_file_copt=^src/legoapi/actions/combat/rope\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/combat/shovesys\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/movement/pushblocks\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/movement/jumping\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/actions/movement/climbing\.cpp$@-O3
# Super-carry movement is optimized in the target; its state dispatch and
# animation-speed selection are folded before the trig-table update.
build:target --per_file_copt=^src/legoapi/actions/movement/carrying\.cpp$@-O3
build:target --per_file_copt=^src/MechInputTouch/MechEdgeStopAddon\.cpp$@-O3
build:target --per_file_copt=^src/MechInputTouch/MechJumpAutopilotAddon\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/render/core/screen\.cpp$@-O3
# Shader material filters use optimized switch lowering and leaf epilogues.
build:target --per_file_copt=^src/nu2api/nu3d/ShaderMtlDescFilter\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/render/fx/edsplines\.cpp$@-O3
# The RefPack encoder uses the original vectorized table initialization and
# optimized match-search loops.
build:target --per_file_copt=^src/legoapi/render/fx/inflate\.cpp$@-O3
# The HTML plotting helpers keep their original optimized codegen after
# moving out of the mixed spline source.
build:target --per_file_copt=^src/legoapi/gizmo/base/gizmo\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/gizmo/base/gizgame\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/gizmo/base/gizactions\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/gizmo/base/gizmessage\.cpp$@-O3
# The flow-box initializer and remap helpers match the target better at -O3.
build:target --per_file_copt=^src/legoapi/gizmo/base/gizflow\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/gizmo/base/gizmo_sys\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/world/levels/levels\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/characters/core/players\.cpp$@-O3
# FinishWeirdoNames uses GCC's -O3 vectorized variable-length fill in the original.
build:target --per_file_copt=^src/legoapi/characters/core/characters\.cpp$@-O3
build:target --per_file_copt=^src/legoapi/characters/core/character\.cpp$@-O2
build:target --per_file_copt=^src/legoapi/characters/motion/gameanim\.cpp$@-O2
