build:target --per_file_copt=^src/legoapi/characters/motion/chris\.cpp$@-fno-ipa-sra
# The original keeps ResetSpaceLevel's full local symbol and passes its two
# pointer arguments in eax/edx; disabling IPA-SRA reproduces that exact shape.
# The retail static constructor stores its VuVec constants with movaps.
# Both pivot routines use optimized loop and vector lowering in the target.
build:target --per_file_copt=^src/legoapi/characters/motion/charpivot\.cpp$@-O3
