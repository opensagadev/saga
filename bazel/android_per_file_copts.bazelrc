build:target --per_file_copt=^src/legoapi/misc/utilities\.cpp$@-O2
build:target --per_file_copt=^src/legoapi/misc/utilities\.cpp$@-ftree-vectorize
build:target --per_file_copt=^src/legoapi/misc/androidbatman\.cpp$@-O3
