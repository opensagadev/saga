load("@rules_python//python:defs.bzl", "py_binary")

_PYTHON_ENV = {"PYTHONDONTWRITEBYTECODE": "1"}

py_binary(
    name = "wasm_server",
    srcs = ["wasm_server.py"],
    data = ["//src:saga_wasm"],
    env = _PYTHON_ENV,
    main = "wasm_server.py",
)

py_binary(
    name = "generate_bazel_objdiff_report",
    srcs = ["generate_bazel_objdiff_report.py"],
    deps = ["//scripts/lib:bazel_actions"],
    env = _PYTHON_ENV,
    main = "generate_bazel_objdiff_report.py",
)

py_binary(
    name = "generate_objdiff_gui_config",
    srcs = ["generate_objdiff_gui_config.py"],
    deps = ["//scripts/lib:bazel_actions"],
    env = _PYTHON_ENV,
    main = "generate_objdiff_gui_config.py",
)

py_binary(
    name = "matching_diff",
    srcs = ["matching_diff.py"],
    env = _PYTHON_ENV,
    main = "matching_diff.py",
)

py_binary(
    name = "objdiff_cli",
    srcs = ["objdiff-cli.py"],
    env = _PYTHON_ENV,
    main = "objdiff-cli.py",
)

py_binary(
    name = "pre_commit",
    srcs = ["pre_commit.py"],
    args = ["$(location //scripts/checks:clang_format)"],
    data = ["//scripts/checks:clang_format"],
    env = _PYTHON_ENV,
    main = "pre_commit.py",
)
