load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

_PYTHON_ENV = {"PYTHONDONTWRITEBYTECODE": "1"}

cc_binary(
    name = "collect_function_declarations",
    srcs = [
        "collect_function_declarations.cpp",
        "@llvm_tools_llvm//:libclang",
    ],
    deps = ["@llvm_tools_llvm//:clang_headers"],
)

filegroup(
    name = "libclang_runtime",
    srcs = select({
        "@platforms//os:macos": ["@llvm_tools_llvm//:lib/libclang.dylib"],
        "@platforms//os:windows": ["@llvm_tools_llvm//:bin/libclang.dll"],
        "//conditions:default": [
            "@llvm_tools_llvm//:lib/libclang.so.22.1",
            "@llvm_tools_llvm//:lib/libclang.so.22.1.8",
        ],
    }),
)

py_test(
    name = "check_duplicate_definitions",
    size = "small",
    srcs = ["check_duplicate_definitions.py"],
    data = ["//src:all_source_files"],
    env = _PYTHON_ENV,
    main = "check_duplicate_definitions.py",
    deps = ["//scripts/lib:ndk_tools"],
)

py_binary(
    name = "check_symbols",
    srcs = ["check_symbols.py"],
    data = [
        "symbols_extra_baseline.txt",
        "symbols_ignore.txt",
    ],
    env = _PYTHON_ENV,
    main = "check_symbols.py",
    deps = ["//scripts/lib:ndk_tools"],
)

py_binary(
    name = "run_clang_tidy",
    srcs = ["run_clang_tidy.py"],
    env = _PYTHON_ENV,
    main = "run_clang_tidy.py",
)

native_binary(
    name = "clang_format",
    src = select({
        "@platforms//os:windows": "@llvm_tools_llvm//:bin/clang-format.exe",
        "//conditions:default": "@llvm_tools_llvm//:bin/clang-format",
    }),
    out = select({
        "@platforms//os:windows": "clang-format.exe",
        "//conditions:default": "clang-format",
    }),
    visibility = ["//visibility:public"],
)

native_binary(
    name = "clang_tidy",
    src = select({
        "@platforms//os:windows": "@llvm_tools_llvm//:bin/clang-tidy.exe",
        "//conditions:default": "@llvm_tools_llvm//:bin/clang-tidy",
    }),
    out = select({
        "@platforms//os:windows": "clang-tidy.exe",
        "//conditions:default": "clang-tidy",
    }),
    visibility = ["//visibility:public"],
)

py_test(
    name = "check_host_boundary",
    size = "small",
    srcs = ["check_host_boundary.py"],
    data = ["//src:all_source_files"],
    env = _PYTHON_ENV,
    main = "check_host_boundary.py",
)

py_library(
    name = "forward_declarations",
    srcs = ["check_forward_declarations.py"],
)

py_binary(
    name = "check_forward_declarations",
    srcs = ["check_forward_declarations.py"],
    data = ["//src:function_declarations"],
    env = _PYTHON_ENV,
    main = "check_forward_declarations.py",
)

py_test(
    name = "test_forward_declarations",
    size = "small",
    srcs = ["test_forward_declarations.py"],
    env = _PYTHON_ENV,
    deps = [":forward_declarations"],
)

py_test(
    name = "check_bazel_optimization_map",
    size = "small",
    srcs = ["check_bazel_optimization_map.py"],
    data = [
        "//bazel:android_optimization_map",
        "//src:all_source_files",
    ],
    env = _PYTHON_ENV,
    main = "check_bazel_optimization_map.py",
)

test_suite(
    name = "checks",
    tests = [
        ":check_bazel_optimization_map",
        ":check_duplicate_definitions",
        ":check_host_boundary",
        ":test_forward_declarations",
        "//scripts:test_pages",
    ],
)
