load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Real loader and fixup providers, isolated from engine startup and assets.
# These are bounded format examples, not malformed-input or gameplay tests.
# Requires a 32-bit C++ toolchain and GLES2 development headers.
cc_test(
    name = "pak_loader_test",
    size = "small",
    srcs = [
        "pak_loader_test.cpp",
        "//src:legoapi/characters/motion/gameanim.cpp",
        "//src:nu2api/nucore/nuanim.cpp",
        "//src:nu2api/nucore/nuptrblock.cpp",
    ],
    additional_compiler_inputs = ["//src:all_source_files"],
    copts = [
        "-Isrc",
        "-x",
        "c++",
        "-std=gnu++17",
        "-m32",
        "-march=i686",
        "-msse2",
        "-mfpmath=sse",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    defines = ["ANDROID"],
    linkopts = [
        "-m32",
        "-Wl,--gc-sections",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
