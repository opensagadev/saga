load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Actual terrain implementation with bounded query fixtures, no engine assets.
# Linux i686 diagnostic; requires a 32-bit C++ toolchain and GLES2 headers.
cc_test(
    name = "terrain_collision_test",
    size = "small",
    srcs = ["terrain_collision_test.cpp"],
    additional_compiler_inputs = ["//src:all_source_files"],
    defines = ["ANDROID"],
    copts = [
        "-Isrc",
        "-std=gnu++17",
        "-m32",
        "-march=i686",
        "-msse2",
        "-mfpmath=sse",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    linkopts = [
        "-m32",
        "-Wl,--gc-sections",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

