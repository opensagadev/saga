diff --git a/lib/saga_vorbis.h b/lib/saga_vorbis.h
new file mode 100644
--- /dev/null
+++ b/lib/saga_vorbis.h
@@ -0,0 +1,20 @@
+#ifndef SAGA_VORBIS_COMPAT_H
+#define SAGA_VORBIS_COMPAT_H
+
+// Target-only integration: the original allocator also zeroes each allocation.
+#include <ogg/ogg.h>
+extern "C" {
+void *OggAllocMem(unsigned int bytes);
+void *OggReAllocMem(void *memory, unsigned int bytes);
+void OggFreeMem(void *memory);
+}
+#undef _ogg_malloc
+#undef _ogg_calloc
+#undef _ogg_realloc
+#undef _ogg_free
+#define _ogg_malloc OggAllocMem
+#define _ogg_calloc(count, size) OggAllocMem((count) * (size))
+#define _ogg_realloc OggReAllocMem
+#define _ogg_free OggFreeMem
+
+#endif
