load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

VORBIS_HEADERS = [
    "include/vorbis/codec.h",
    "include/vorbis/vorbisfile.h",
]

VORBIS_PRIVATE_HEADERS = [
    "lib/backends.h",
    "lib/bitrate.h",
    "lib/codebook.h",
    "lib/codec_internal.h",
    "lib/envelope.h",
    "lib/highlevel.h",
    "lib/lookup.h",
    "lib/lookup_data.h",
    "lib/lpc.h",
    "lib/lsp.h",
    "lib/masking.h",
    "lib/mdct.h",
    "lib/misc.h",
    "lib/os.h",
    "lib/modes/floor_all.h",
    "lib/modes/psych_11.h",
    "lib/modes/psych_16.h",
    "lib/modes/psych_44.h",
    "lib/modes/psych_8.h",
    "lib/modes/residue_16.h",
    "lib/modes/residue_44.h",
    "lib/modes/residue_44p51.h",
    "lib/modes/residue_44u.h",
    "lib/modes/residue_8.h",
    "lib/modes/setup_11.h",
    "lib/modes/setup_16.h",
    "lib/modes/setup_22.h",
    "lib/modes/setup_32.h",
    "lib/modes/setup_44.h",
    "lib/modes/setup_44p51.h",
    "lib/modes/setup_44u.h",
    "lib/modes/setup_8.h",
    "lib/modes/setup_X.h",
    "lib/psy.h",
    "lib/registry.h",
    "lib/scales.h",
    "lib/smallft.h",
    "lib/window.h",
    "lib/books/coupled/res_books_51.h",
    "lib/books/coupled/res_books_stereo.h",
    "lib/books/floor/floor_books.h",
    "lib/books/uncoupled/res_books_uncoupled.h",
]

cc_library(
    name = "vorbis",
    srcs = [
        "lib/analysis.c",
        "lib/bitrate.c",
        "lib/block.c",
        "lib/codebook.c",
        "lib/envelope.c",
        "lib/floor0.c",
        "lib/floor1.c",
        "lib/info.c",
        "lib/lookup.c",
        "lib/lpc.c",
        "lib/lsp.c",
        "lib/mapping0.c",
        "lib/mdct.c",
        "lib/psy.c",
        "lib/registry.c",
        "lib/res0.c",
        "lib/sharedbook.c",
        "lib/smallft.c",
        "lib/synthesis.c",
        "lib/window.c",
    ],
    hdrs = VORBIS_HEADERS + VORBIS_PRIVATE_HEADERS,
    copts = [
        "-DUSE_MEMORY_H",
    ] + select({
        # MinGW declares alloca in <malloc.h>, which os.h includes on _WIN32.
        "@platforms//os:windows": [],
        "//conditions:default": ["-DHAVE_ALLOCA_H"],
    }),
    includes = [
        "include",
        "lib",
    ],
    linkopts = ["-lm"],
    deps = ["@libogg_wasm//:ogg"],
)

cc_library(
    name = "vorbisfile",
    srcs = ["lib/vorbisfile.c"],
    hdrs = ["include/vorbis/vorbisfile.h"],
    includes = [
        "include",
        "lib",
    ],
    deps = [
        ":vorbis",
        "@libogg_wasm//:ogg",
    ],
)
